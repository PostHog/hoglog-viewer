    "simple-icons": "^16.38.1"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "prettier": "^3.10.1",
    "typescript": "^6",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "packageManager": "pnpm@10.34.5"
}
