    "remark-gfm": "^4.0.1",
    "simple-icons": "^16.38.1"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^6",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
